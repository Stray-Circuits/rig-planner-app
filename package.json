{
  "name": "rig-planner-app",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Pedalboard planning app with signal-path overlay — desktop + mobile",
  "author": "Stray Circuits",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "imgly:fetch": "node scripts/fetch-imgly-assets.mjs",
    "predev": "pnpm imgly:fetch",
    "prebuild": "pnpm imgly:fetch",
    "pretauri:dev": "pnpm imgly:fetch",
    "pretauri:build": "pnpm imgly:fetch",
    "pretauri:android:dev": "pnpm imgly:fetch",
    "pretauri:ios:dev": "pnpm imgly:fetch",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:clean": "node scripts/tauri-clean.mjs",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "android:container:image": "scripts/android/build.sh build-image",
    "android:container:init": "scripts/android/build.sh init",
    "android:container:build": "scripts/android/build.sh build",
    "android:container:build:release": "scripts/android/build.sh build --release",
    "android:container:shell": "scripts/android/build.sh shell",
    "android:container:clean": "scripts/android/build.sh clean",
    "version:set": "node scripts/version-set.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "node scripts/check-npm-licenses.mjs"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-sharekit-api": "^0.3.1",
    "@dnd-kit/core": "^6.3.1",
