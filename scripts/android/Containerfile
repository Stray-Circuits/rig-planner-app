# Rig Planner — Android build container
#
# Provides every toolchain Tauri 2 needs to cross-compile + package an Android
# APK from this repo, so the host only needs Podman.
#
# Tooling:
#   - JDK 17 (Eclipse Temurin)        — Gradle / AGP
#   - Node 20 + pnpm 9                — Vite production build of the web bundle
#   - Rust stable + Android targets   — cargo cross-compile to .so per ABI
#   - Android cmdline-tools + SDK 34  — Gradle + AGP build deps
#   - Android NDK r26d                — native toolchain for Rust targets
#
# Built for linux/arm64 (Apple silicon host) by default. To build/run on
# amd64, pass `--platform linux/amd64` to podman.

FROM docker.io/library/eclipse-temurin:17-jdk-jammy

ARG NODE_VERSION=20.18.1
ARG PNPM_VERSION=9.15.0
ARG ANDROID_CMDLINE_TOOLS_VERSION=11076708
ARG ANDROID_PLATFORM_VERSION=34
ARG ANDROID_BUILD_TOOLS_VERSION=34.0.0
ARG ANDROID_NDK_VERSION=26.3.11579264
ARG RUST_VERSION=1.84.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Base OS packages. `unzip`, `curl`, `git` are required by sdkmanager + rustup +
# tauri; `pkg-config` + `build-essential` cover anything cargo build.rs scripts
# need on host. `file` is needed by some gradle android plugin tasks.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        unzip \
        zip \
        xz-utils \
        build-essential \
        pkg-config \
        file \
        python3 \
 && rm -rf /var/lib/apt/lists/*

# --- Node + pnpm -------------------------------------------------------------
# Install Node from the official tarball so we don't depend on NodeSource's apt
# repo signing key. Pick the right arch for the build host.
RUN set -eux; \
    case "$(uname -m)" in \
      aarch64) NODE_ARCH=arm64 ;; \
      x86_64)  NODE_ARCH=x64 ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"; \
    tar -xJf "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -C /usr/local --strip-components=1; \
    rm "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"; \
    node --version; \
    corepack enable; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate; \
    pnpm --version

# --- Android SDK -------------------------------------------------------------
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

RUN set -eux; \
    mkdir -p "${ANDROID_HOME}/cmdline-tools"; \
    curl -fsSLo /tmp/cmdline-tools.zip \
      "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip"; \
    unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools"; \
    mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest"; \
    rm /tmp/cmdline-tools.zip; \
    yes | sdkmanager --licenses > /dev/null; \
    sdkmanager \
      "platform-tools" \
      "platforms;android-${ANDROID_PLATFORM_VERSION}" \
      "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
      "ndk;${ANDROID_NDK_VERSION}"

ENV NDK_HOME="${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION}" \
    ANDROID_NDK_HOME="${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION}" \
    ANDROID_NDK_ROOT="${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION}"

# --- Rust + Android targets --------------------------------------------------
# Install rustup as a non-root user so cargo caches and rustup state live in a
# predictable HOME. Inside the container we still run as root (Podman maps it
# to the host UID via userns); the wrapper script handles ownership.
ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"

RUN set -eux; \
    curl -fsSL https://sh.rustup.rs | sh -s -- \
      -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}"; \
    rustup target add \
      aarch64-linux-android \
      armv7-linux-androideabi \
      i686-linux-android \
      x86_64-linux-android; \
    rustc --version; \
    cargo --version

# --- Tauri CLI ---------------------------------------------------------------
# The repo's `pnpm tauri ...` script invokes the JS wrapper from
# `@tauri-apps/cli`, which spawns the Rust `tauri-cli` binary. Pre-install the
# Rust binary so the first build doesn't have to compile it from source.
RUN cargo install tauri-cli --version "^2" --locked

# --- Container hygiene -------------------------------------------------------
# Pnpm needs a writable store dir; default to a path the wrapper script will
# mount as a named volume so the store persists between builds.
ENV PNPM_HOME=/opt/pnpm \
    PNPM_STORE_DIR=/opt/pnpm/store
ENV PATH="${PNPM_HOME}:${PATH}"
RUN mkdir -p "${PNPM_HOME}" "${PNPM_STORE_DIR}"

WORKDIR /workspace

# Default command drops into a shell. The build wrapper overrides with the
# real command.
CMD ["/bin/bash"]
