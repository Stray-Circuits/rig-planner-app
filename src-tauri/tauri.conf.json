{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rig Planner",
  "version": "0.0.1",
  "identifier": "com.straycircuits.rigplanner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rig Planner",
        "width": 1100,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Pedalboard planner with signal path",
    "longDescription": "Plan your pedalboard layout and signal chain on mobile or desktop."
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:rigplanner.db"]
    }
  }
}
